# DeepSeek API Key（必需）
DEEPSEEK_API_KEY=sk-your-api-key-here

# SiliconFlow Embedding API（向量检索用）
EMBEDDING_API_KEY=sk-your-embedding-api-key-here
EMBEDDING_MODEL=BAAI/bge-m3

# PostgreSQL 配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_NAME=log_analysis
DB_SSLMODE=disable

# 服务端口（可选，默认 8080）
PORT=8080
